MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=memgraph

EMBEDDING_ENABLED=true
EMBEDDING_LOCAL=true
# Local mode uses the medically trained model aleynahukmet/bge-medical-small-en-v1.5.
# For remote HuggingFace Inference API, use `BAAI/bge-small-en-v1.5` instead.
# the medical model is not hosted on HF Inference.
EMBEDDING_MODEL_NAME=aleynahukmet/bge-medical-small-en-v1.5
EMBEDDING_HF_TOKEN=

GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

CORS_ORIGINS=["http://localhost:5173"]
DEBUG=false
UPLOAD_MAX_SIZE_MB=250
